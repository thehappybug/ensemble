# Copy this file to the WORKSPACE root as .env; keep actual values out of git.
# Existing Cline login is read from an isolated copy, but live OAuth reuse and
# refresh were not verified. Prefer an explicit key for the real demo.
CLINE_API_KEY=
PARALLEL_API_KEY=

# Only for composio.backend: sdk, or auto selecting a project SDK backend.
# CLI mode uses the Composio CLI's own consumer-project login and connections.
# A ck_ or uak_ consumer key is not an SDK project API key.
# COMPOSIO_API_KEY=ak_replace_with_your_project_key

# Optional alternative provider credentials, only if llm.provider is changed.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
